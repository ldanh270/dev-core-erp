{
  "name": "devcore-erp",
  "version": "1.0.0",
  "description": "DevCore ERP: Web-Based Enterprise Resource Planning System for IT Outsourcing Companies",
  "scripts": {
    "dev": "concurrently \"nr dev:backend\" \"nr dev:frontend\"",
    "dev:all": "concurrently \"nr dev:backend\" \"nr dev:frontend\" \"nr dev:mcp\" \"nr dev:gateway\"",
    "i:all": "ni && nr i:backend && nr i:frontend && nr i:mcp && nr i:gateway",
    "i:backend": "cd backend && ni",
    "i:frontend": "cd frontend && ni",
    "i:mcp": "cd mcp-server && ni",
    "i:gateway": "cd agent-gateway && ni",
    "dev:backend": "cd backend && nr dev",
    "dev:frontend": "cd frontend && nr dev",
    "dev:mcp": "cd mcp-server && nr dev",
    "dev:gateway": "cd agent-gateway && nr dev",
    "build": "nr db:reset:force && nr db:deploy && nr build:frontend",
    "build:frontend": "cd frontend && nr build",
    "db:deploy": "cd backend && npx prisma generate && npx prisma migrate deploy",
    "db:migrate": "cd backend && npx prisma migrate dev",
    "db:generate": "cd backend && npx prisma generate",
    "db:reset": "cd backend && npx prisma migrate reset",
    "db:reset:force": "cd backend && npx prisma migrate reset --force",
    "db:studio": "cd backend && npx prisma studio",
    "db:seed": "cd backend && nr seed",
    "db:seed:fresh": "cd backend && nr seed:fresh",
    "db:seed:incremental": "cd backend && nr seed:incremental",
    "db:seed:admin": "cd backend && nr seed:admin",
    "db:clear": "cd backend && nr clear",
    "hash-password": "cd backend && nr hash-password",
    "test": "jest",
    "lint:codacy": "cd frontend && nr lint && nr lint:styles",
    "quality:codacy": "nr lint:codacy"
  },
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "escalade": "^3.2.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@antfu/ni": "^30.1.0",
    "@ldanh270/aatest": "^1.0.19",
    "concurrently": "^9.2.4",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
