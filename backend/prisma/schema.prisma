// DevCore ERP database schema.
// Modules group their enums and models by business responsibility.
// Use /// for enum, model, and field documentation; use // for module and section notes.
// Relations and constraints below define persistence rules; workflow enforcement belongs to the application.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Module: Employees and positions
// Core employee identities and organizational positions shared by business modules.

/// Employment lifecycle states recorded on employee profiles.
enum EmployeeStatus {
  active
  inactive
  on_leave
  terminated
}

/// Employment engagement categories shared by employees and recruitment records.
enum EmployeeType {
  full_time
  part_time
  contractor
  intern
}

/// Organizational position with allowed task trackers and application types. Links employees, scoped holidays, and hiring requisitions.
model Position {
  id                      String            @id @default(cuid())
  name                    String
  code                    String
  description             String?
  allowedTaskTrackers     String[]
  allowedApplicationTypes ApplicationType[]

  employees    Employee[]
  holidays     HolidayCalendar[]
  requisitions JobRequisition[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
  @@index([code])
  @@index([deletedAt])
  @@map("positions")
}

/// Central employee identity, employment profile, and authentication state. Named relations distinguish ownership, creation, assignment, and approval across modules.
model Employee {
  id                    String           @id @default(cuid())
  fullName              String
  username              String
  passwordHash          String
  email                 String
  phone                 String?
  dateOfBirth           DateTime?
  nationalId            String?
  address               String?
  avatarUrl             String?
  avatarId              String?
  position              String?
  positionId            String?
  positionRel           Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employeeType          EmployeeType     @default(full_time)
  workScheduleType      WorkScheduleType @default(full_time)
  status                EmployeeStatus   @default(active)
  failedLoginCount      Int              @default(0)
  lockedUntil           DateTime?
  startDate             DateTime?        @db.Date
  endDate               DateTime?        @db.Date
  lastLoginAt           DateTime?
  personalEmployeeId    String?
  personalEmployee      Employee?        @relation("PersonalEmployeeLink", fields: [personalEmployeeId], references: [id], onDelete: SetNull)
  personalEmployeeLinks Employee[]       @relation("PersonalEmployeeLink")

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  version              Int       @default(1)
  authorizationVersion Int       @default(1)

  // Notification relations
  targetedNotifications Notification[]               @relation("NotificationTarget")
  notificationStates    NotificationRecipientState[]

  // Relations
  auditLogsActed                 AuthorizationAuditLog[]      @relation("AuditLogActor")
  auditLogsTargeted              AuthorizationAuditLog[]      @relation("AuditLogTarget")
  attendanceRecords              AttendanceRecord[]
  realShifts                     RealShift[]
  employeeShifts                 EmployeeShift[]              @relation("EmployeeShiftEmployee")
  employeeShiftsCreated          EmployeeShift[]              @relation("EmployeeShiftCreator")
  applications                   Application[]                @relation("ApplicationEmployee")
  applicationsApproved           Application[]                @relation("ApplicationApprover")
  applicationsAssigned           Application[]                @relation("ApplicationAssignedTo")
  applicationsPartnerApproved    Application[]                @relation("ApplicationPartnerApprover")
  swapApplicationsAsPartner      ApplicationShiftSwapDetail[] @relation("ApplicationSwapWith")
  shiftSchedules                 ShiftSchedule[]              @relation("ShiftScheduleEmployee")
  shiftSchedulesCreated          ShiftSchedule[]              @relation("ShiftScheduleCreator")
  workingShiftsCreated           WorkingShift[]
  weeklyScheduleTemplatesCreated WeeklyScheduleTemplate[]     @relation("WeeklyScheduleTemplateCreator")
  holidayCalendarsCreated        HolidayCalendar[]
  holidayCalendarAssignees       HolidayCalendarAssignee[]
  salaryVariablesCreated         SalaryVariable[]
  salaryComponentsCreated        SalaryComponent[]
  payslipTemplatesCreated        PayslipTemplate[]
  salaryConfigs                  EmployeeSalaryConfig[]
  salaryConfigsCreated           EmployeeSalaryConfig[]       @relation("SalaryConfigCreator")
  payrollSettingsUpdated         PayrollSettings[]
  weeklyScheduleSettingsUpdated  WeeklyScheduleSettings[]
  payrollsApproved               Payroll[]
  payslips                       Payslip[]
  projectsLead                   Project[]                    @relation("ProjectTeamLeader")
  projectsCreated                Project[]                    @relation("ProjectCreator")
  projectMembers                 ProjectMember[]
  tasksAssigned                  Task[]                       @relation("TaskAssignee")
  recruitmentOAuthAccounts       RecruitmentOAuthAccount[]
  tasksCreated                   Task[]                       @relation("TaskCreator")
  activityLogs                   ActivityLog[]
  passwordResetRequests          PasswordResetRequest[]       @relation("PasswordResetRequestEmployee")
  passwordResetRequestsApprd     PasswordResetRequest[]       @relation("PasswordResetRequestApprover")
  refreshTokens                  RefreshToken[]
  spentTimes                     SpentTime[]                  @relation("EmployeeSpentTimes")
  employeeRoles                  EmployeeRole[]
  spentTimesApproved             SpentTime[]                  @relation("SpentTimeApprover")
  customQueries                  CustomQuery[]
  partTimeWeeklyAvailabilities   PartTimeWeeklyAvailability[] @relation("PartTimeAvailabilityEmployee")
  partTimeAvailabilitiesReviewed PartTimeWeeklyAvailability[] @relation("PartTimeAvailabilityReviewer")
  leaveBalances                  EmployeeLeaveBalance[]
  regimeCategoriesCreated        RegimeCategory[]
  contracts                      EmployeeContract[]           @relation("EmployeeContracts")
  contractsCreated               EmployeeContract[]           @relation("ContractCreator")
  contractsUpdated               EmployeeContract[]           @relation("ContractUpdater")

  // Recruitment relations
  requisitionsRequested         JobRequisition[]             @relation("RequisitionRequester")
  requisitionsAssignedToApprove JobRequisition[]             @relation("RequisitionDesignatedApprover")
  requisitionsApproved          JobRequisition[]             @relation("RequisitionApprover")
  recruitmentAppsAssigned       RecruitmentApplication[]     @relation("RecruitmentAppRecruiter")
  scorecardsEvaluated           Scorecard[]                  @relation("ScorecardEvaluator")
  offersCreated                 RecruitmentOffer[]           @relation("OfferCreator")
  bgcChecked                    BackgroundCheck[]            @relation("BgcChecker")
  recruitmentNotesCreated       ApplicationNote[]            @relation("RecruitmentNoteCreator")
  recruitmentPostingActivities  RecruitmentPostingActivity[] @relation("RecruitmentPostingActivityActor")
  archivedRecruitmentPostings   JobPosting[]                 @relation("RecruitmentPostingArchiver")

  @@index([status, employeeType])
  @@index([deletedAt, createdAt(sort: Desc)])
  @@index([deletedAt, status, workScheduleType])
  @@index([status, deletedAt])
  @@index([lockedUntil])
  @@index([failedLoginCount])
  @@index([positionId])
  @@index([personalEmployeeId])
  @@index([username])
  @@index([email])
}

// Module: Employee contracts
// Employment agreements, compensation terms, and contract renewal history.

/// Supported legal engagement types for employee contracts.
enum ContractType {
  trial
  definite
  indefinite
  service
}

/// Contract lifecycle states, including signature, termination, and renewal.
enum ContractStatus {
  draft
  pending_signature
  active
  expired
  terminated
  renewed
}

/// Employment agreement with salary terms, dates, attachments, and author records. Self-relations link a renewed contract to its predecessor and successors.
model EmployeeContract {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation("EmployeeContracts", fields: [employeeId], references: [id], onDelete: Cascade)

  contractType   ContractType
  contractNumber String
  title          String?

  signedDate   DateTime? @db.Date
  startDate    DateTime  @db.Date
  endDate      DateTime? @db.Date
  trialEndDate DateTime? @db.Date

  salary   Decimal @db.Decimal(15, 2)
  currency String  @default("VND")

  allowances  Json?
  attachments String[]

  status            ContractStatus @default(draft)
  terminationReason String?
  terminationDate   DateTime?

  probationSalary     Decimal? @db.Decimal(15, 2)
  probationSalaryRate Decimal? @db.Decimal(5, 2)

  createdById String
  createdBy   Employee  @relation("ContractCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   Employee? @relation("ContractUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  note        String?

  renewedFromId String?
  renewedFrom   EmployeeContract?  @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedTo     EmployeeContract[] @relation("ContractRenewal")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([employeeId])
  @@index([status, endDate])
  @@index([contractNumber])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([renewedFromId])
}

// Module: Work schedules and attendance
// Shift definitions, recurring schedules, part-time availability, and recorded attendance.

/// Scheduling categories used independently of employment engagement type.
enum WorkScheduleType {
  full_time
  part_time
}

/// Assignment states for a dated employee shift.
enum ShiftStatus {
  scheduled
  holiday_pending
  confirmed
  cancelled
}

/// Recorded attendance outcomes for an assigned shift.
enum AttendanceStatus {
  on_time
  late
  early_leave
  absent
  overtime
}

/// Review states for an employee's weekly part-time availability submission.
enum PartTimeAvailabilityStatus {
  draft
  submitted
  approved
  rejected
}

/// Reusable shift definition with time boundaries, break settings, and attendance location rules. Referenced by templates, schedules, assignments, and swap requests.
model WorkingShift {
  id                 String   @id @default(cuid())
  name               String
  startTime          Int
  endTime            Int
  breakStartTime     Int?
  breakEndTime       Int?
  gracePeriodMinutes Int      @default(15)
  gpsLat             Float?
  gpsLng             Float?
  gpsRadiusMeters    Float    @default(100)
  isActive           Boolean  @default(true)
  createdById        String
  createdBy          Employee @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeShifts EmployeeShift[]

  shiftScheduleDays           ShiftScheduleDay[]
  weeklyScheduleTemplateDays  WeeklyScheduleTemplateDay[]
  applicationShiftSwapDetails ApplicationShiftSwapDetail[] @relation("ShiftSwapWorkingShift")

  @@index([isActive])
  @@index([createdById])
}

/// Schedule generation timing and the last generated week key. The identifier defaults to GLOBAL; the schema does not prevent other identifiers.
model WeeklyScheduleSettings {
  id                   String   @id @default("GLOBAL")
  triggerDayOfWeek     Int
  triggerHour          Int      @default(7)
  triggerMinute        Int      @default(0)
  lastGeneratedWeekKey String?
  updatedById          String
  updatedBy            Employee @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedById])
}

/// Reusable recurring schedule definition. Contains ordered cycle weeks and is referenced by employee schedules.
model WeeklyScheduleTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  cycleWeeks  Int      @default(1)
  isActive    Boolean  @default(true)
  createdById String
  createdBy   Employee @relation("WeeklyScheduleTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  weeks          WeeklyScheduleTemplateWeek[]
  shiftSchedules ShiftSchedule[]

  @@index([isActive])
  @@index([createdById])
}

/// One week within a recurring template. The template and week index uniquely identify each cycle week.
model WeeklyScheduleTemplateWeek {
  id         String                 @id @default(cuid())
  templateId String
  template   WeeklyScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  weekIndex  Int

  days WeeklyScheduleTemplateDay[]

  @@unique([templateId, weekIndex])
}

/// One weekday within a template week. The shift relation is optional; each week can contain only one entry per weekday.
model WeeklyScheduleTemplateDay {
  id        String                     @id @default(cuid())
  weekId    String
  week      WeeklyScheduleTemplateWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  shiftId   String?
  shift     WorkingShift?              @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([weekId, dayOfWeek])
  @@index([shiftId])
}

/// Employee schedule with an effective date range and optional source template. Owns recurring day definitions and generated employee shift assignments.
model ShiftSchedule {
  id          String                  @id @default(cuid())
  employeeId  String
  employee    Employee                @relation("ShiftScheduleEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  validFrom   DateTime
  validTo     DateTime?
  templateId  String?
  template    WeeklyScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  cycleWeeks  Int?
  createdById String
  createdBy   Employee                @relation("ShiftScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days           ShiftScheduleDay[]
  employeeShifts EmployeeShift[]

  @@index([employeeId, validFrom(sort: Desc)])
  @@index([validTo])
  @@index([createdById])
  @@index([templateId])
}

/// Working shift for a weekday and cycle week within an employee schedule. The schedule, week index, and weekday form a unique assignment.
model ShiftScheduleDay {
  id         String        @id @default(cuid())
  scheduleId String
  schedule   ShiftSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weekIndex  Int           @default(0)
  dayOfWeek  Int
  shiftId    String
  shift      WorkingShift  @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@unique([scheduleId, weekIndex, dayOfWeek])
  @@index([shiftId])
}

/// Dated working shift assigned to an employee, optionally generated from a schedule. Links attendance and shift-specific application details; duplicate employee/date/shift combinations are prevented.
model EmployeeShift {
  id           String         @id @default(cuid())
  employeeId   String
  employee     Employee       @relation("EmployeeShiftEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  shiftId      String
  shift        WorkingShift   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  assignedDate DateTime       @db.Date
  scheduleId   String?
  schedule     ShiftSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  status       ShiftStatus    @default(scheduled)
  isOverride   Boolean        @default(false)
  createdById  String
  createdBy    Employee       @relation("EmployeeShiftCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecord    AttendanceRecord?
  overtimeDetails     ApplicationOvertimeDetail[]     @relation("ApplicationOvertimeShift")
  swapDetails         ApplicationShiftSwapDetail[]    @relation("ApplicationEmployeeShift")
  swapWithDetails     ApplicationShiftSwapDetail[]    @relation("ApplicationSwapWithShift")
  lateEarlyDetails    ApplicationLateEarlyDetail[]    @relation("ApplicationLateEarlyShift")
  workFromHomeDetails ApplicationWorkFromHomeDetail[]
  forgotCardDetails   ApplicationForgotCardDetail[]   @relation("ApplicationForgotCardShift")

  @@unique([employeeId, assignedDate, shiftId])
  @@index([employeeId, assignedDate, isOverride])
  @@index([assignedDate, status])
  @@index([shiftId, assignedDate])
  @@index([status, assignedDate])
  @@index([scheduleId])
  @@index([createdById])
}

/// Employee availability submission for a week, including review metadata. Owns daily entries and is unique per employee and week start.
model PartTimeWeeklyAvailability {
  id           String                     @id @default(cuid())
  employeeId   String
  employee     Employee                   @relation("PartTimeAvailabilityEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  weekStart    DateTime                   @db.Date
  status       PartTimeAvailabilityStatus @default(submitted)
  note         String?
  submittedAt  DateTime?
  reviewedById String?
  reviewedBy   Employee?                  @relation("PartTimeAvailabilityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days PartTimeAvailabilityDay[]

  @@unique([employeeId, weekStart])
  @@index([weekStart])
  @@index([status])
  @@index([reviewedById])
}

/// Daily entry within a weekly availability submission. Stores the all-day busy flag and associated time slots; weekdays are unique within a submission.
model PartTimeAvailabilityDay {
  id             String                     @id @default(cuid())
  availabilityId String
  availability   PartTimeWeeklyAvailability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  dayOfWeek      Int
  isBusyAllDay   Boolean                    @default(false)

  slots PartTimeAvailabilitySlot[]

  @@unique([availabilityId, dayOfWeek])
}

/// Time interval belonging to a daily availability entry. Stores display ordering alongside its start and end boundaries.
model PartTimeAvailabilitySlot {
  id        String                  @id @default(cuid())
  dayId     String
  day       PartTimeAvailabilityDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  startTime Int
  endTime   Int
  sortOrder Int                     @default(0)

  @@index([dayId])
}

/// Check-in, check-out, location, and calculated attendance totals for one employee shift. Unique relations allow at most one correction application and one actual-shift record per attendance record.
model AttendanceRecord {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeShiftId String        @unique
  employeeShift   EmployeeShift @relation(fields: [employeeShiftId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date

  checkInAt  DateTime?
  checkInLat Float?
  checkInLng Float?

  checkOutAt  DateTime?
  checkOutLat Float?
  checkOutLng Float?

  status            AttendanceStatus
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  overtimeMinutes   Int              @default(0)
  totalWorkMinutes  Int              @default(0)
  note              String?

  correctedByApplicationId String?      @unique
  correctedByApplication   Application? @relation("AttendanceRecordCorrection", fields: [correctedByApplicationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  realShift RealShift?

  @@index([employeeId, date(sort: Desc)])
  @@index([date(sort: Desc), status])
  @@index([status, date(sort: Desc)])
}

/// Actual working-time boundaries associated with an attendance record. Includes matching and paid-leave flags; each attendance record has at most one actual-shift record.
model RealShift {
  id                 String           @id @default(cuid())
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attendanceRecordId String           @unique
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  date               DateTime         @db.Date
  actualStartTime    Int
  actualEndTime      Int?
  isMatched          Boolean          @default(false)
  isPaidLeave        Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date(sort: Desc)])
  @@index([isMatched, date(sort: Desc)])
}

// Module: Employee applications and leave
// Employee requests, review metadata, request details, and annual leave balances.

/// Employee request categories used to select the relevant application details.
enum ApplicationType {
  leave
  overtime
  work_from_home
  shift_swap
  business_trip
  late_early
  regime
  resignation
  forgot_card
  recruitment
}

/// Employee request review states, including partner approval for coordinated requests.
enum ApplicationStatus {
  pending
  partner_pending
  approved
  rejected
  cancelled
}

/// Leave categories recorded in employee leave request details.
enum LeaveType {
  annual_leave
  sick_leave
  maternity_leave
  bereavement_leave
  marriage_leave
  unpaid_leave
  other
}

/// Paid or unpaid treatment recorded for a leave request.
enum RegimeType {
  paid
  unpaid
}

/// Employee request header with a date range, review metadata, and optional type-specific details. Detail tables use the application identifier as their primary key; type/detail consistency is not enforced here.
model Application {
  id         String            @id @default(cuid())
  employeeId String
  employee   Employee          @relation("ApplicationEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  type       ApplicationType
  status     ApplicationStatus @default(pending)
  startDate  DateTime
  endDate    DateTime
  reason     String?
  note       String?

  approvedById String?
  approvedBy   Employee? @relation("ApplicationApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?
  rejectReason String?

  partnerApprovedById String?
  partnerApprovedBy   Employee? @relation("ApplicationPartnerApprover", fields: [partnerApprovedById], references: [id], onDelete: SetNull)
  partnerApprovedAt   DateTime?
  partnerRejectReason String?

  assignedToId String?
  assignedTo   Employee? @relation("ApplicationAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveDetail                ApplicationLeaveDetail?
  shiftSwapDetail            ApplicationShiftSwapDetail?
  overtimeDetail             ApplicationOvertimeDetail?
  regimeDetail               ApplicationRegimeDetail?
  lateEarlyDetail            ApplicationLateEarlyDetail?
  businessTripDetail         ApplicationBusinessTripDetail?
  workFromHomeDetail         ApplicationWorkFromHomeDetail?
  forgotCardDetail           ApplicationForgotCardDetail?
  recruitmentDetail          ApplicationRecruitmentDetail?
  attendanceRecordCorrection AttendanceRecord?              @relation("AttendanceRecordCorrection")

  @@index([employeeId, status])
  @@index([employeeId, createdAt(sort: Desc)])
  @@index([employeeId, startDate(sort: Desc)])
  @@index([status, type])
  @@index([status, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([approvedById])
  @@index([partnerApprovedById])
  @@index([assignedToId, status, createdAt(sort: Desc)])
}

/// Annual leave allocation and usage for an employee. A unique employee/year pair prevents duplicate annual balance records.
model EmployeeLeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  totalDays  Decimal  @db.Decimal(5, 2)
  usedDays   Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year])
  @@index([employeeId, year])
}

/// Reusable attendance allowance category with late-arrival and early-departure limits. Referenced by regime request details.
model RegimeCategory {
  id              String   @id @default(cuid())
  name            String
  maxLateMinutes  Int      @default(0)
  maxEarlyMinutes Int      @default(0)
  isDefault       Boolean  @default(false)
  createdById     String
  createdBy       Employee @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regimeDetails ApplicationRegimeDetail[]

  @@index([createdById])
  @@index([isDefault])
}

/// One-to-one leave request details containing leave category, pay treatment, and an optional supporting document.
model ApplicationLeaveDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  leaveType     LeaveType
  regimeType    RegimeType
  documentUrl   String?
}

/// One-to-one shift change or swap request details. References the employee shift and optional replacement shift or swap partner.
model ApplicationShiftSwapDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  employeeShiftId String
  employeeShift   EmployeeShift @relation("ApplicationEmployeeShift", fields: [employeeShiftId], references: [id], onDelete: Cascade)

  workingShiftId String?
  workingShift   WorkingShift? @relation("ShiftSwapWorkingShift", fields: [workingShiftId], references: [id], onDelete: Cascade)

  swapWithEmployeeId String?
  swapWithEmployee   Employee?      @relation("ApplicationSwapWith", fields: [swapWithEmployeeId], references: [id], onDelete: Cascade)
  swapWithShiftId    String?
  swapWithShift      EmployeeShift? @relation("ApplicationSwapWithShift", fields: [swapWithShiftId], references: [id], onDelete: Cascade)

  @@index([employeeShiftId])
  @@index([workingShiftId])
  @@index([swapWithEmployeeId])
  @@index([swapWithShiftId])
}

/// One-to-one overtime request details linked to the affected employee shift.
model ApplicationOvertimeDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  employeeShiftId String
  employeeShift   EmployeeShift @relation("ApplicationOvertimeShift", fields: [employeeShiftId], references: [id], onDelete: Cascade)

  @@index([employeeShiftId])
}

/// One-to-one attendance allowance request details. References a regime category and records requested late-arrival and early-departure minutes.
model ApplicationRegimeDetail {
  applicationId    String         @id
  application      Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  regimeCategoryId String
  regimeCategory   RegimeCategory @relation(fields: [regimeCategoryId], references: [id], onDelete: Restrict)
  lateMinutes      Int            @default(0)
  earlyMinutes     Int            @default(0)
  documentUrl      String?

  @@index([regimeCategoryId])
}

/// One-to-one late-arrival or early-departure request details for an employee shift. The direction flag distinguishes late arrival from early departure.
model ApplicationLateEarlyDetail {
  applicationId   String        @id
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employeeShiftId String
  employeeShift   EmployeeShift @relation("ApplicationLateEarlyShift", fields: [employeeShiftId], references: [id], onDelete: Cascade)
  durationMinutes Int
  isLate          Boolean

  @@index([employeeShiftId])
}

/// One-to-one business trip request details containing destination, purpose, and an optional budget.
model ApplicationBusinessTripDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  location      String
  purpose       String?
  budget        Decimal?    @db.Decimal(15, 2)
}

/// One-to-one remote-work request details linked to an employee shift.
model ApplicationWorkFromHomeDetail {
  applicationId   String        @id
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employeeShiftId String
  employeeShift   EmployeeShift @relation(fields: [employeeShiftId], references: [id], onDelete: Restrict)

  @@index([employeeShiftId])
}

/// One-to-one attendance correction request details for an employee shift. Stores optional replacement check-in/check-out timestamps and supporting evidence.
model ApplicationForgotCardDetail {
  applicationId   String        @id
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employeeShiftId String
  employeeShift   EmployeeShift @relation("ApplicationForgotCardShift", fields: [employeeShiftId], references: [id], onDelete: Cascade)
  checkInAt       DateTime?
  checkOutAt      DateTime?
  documentUrl     String?

  @@index([employeeShiftId])
}

/// One-to-one internal hiring request details with position information, headcount, and requirements. positionId is a scalar reference without a Prisma relation.
model ApplicationRecruitmentDetail {
  applicationId String      @id
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  positionId   String?
  positionName String
  quantity     Int
  requirements String? @db.Text
}

// Module: Holiday calendars
// Dated holidays scoped to all employees, positions, or explicit employee assignments.

/// Holiday categories distinguishing national holidays from company holidays.
enum HolidayType {
  national
  company
}

/// Holiday applicability categories: all employees, a position, or explicitly assigned employees.
enum HolidayScope {
  all
  position
  employees
}

/// Dated holiday definition with scope, optional position, and explicit employee assignees. batchId groups related entries; scope and assignment consistency is not enforced here.
model HolidayCalendar {
  id          String                    @id @default(cuid())
  date        DateTime                  @db.Date
  name        String
  type        HolidayType
  scope       HolidayScope              @default(all)
  positionId  String?
  position    Position?                 @relation(fields: [positionId], references: [id], onDelete: SetNull)
  batchId     String?
  createdById String
  createdBy   Employee                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignees   HolidayCalendarAssignee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([type, date])
  @@index([scope, date])
  @@index([positionId])
  @@index([batchId])
  @@index([createdById])
}

/// Join record assigning a holiday to an employee. The composite primary key prevents duplicate assignments.
model HolidayCalendarAssignee {
  holidayId  String
  holiday    HolidayCalendar @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([holidayId, employeeId])
  @@index([employeeId])
}

// Module: Payroll and compensation
// Salary formulas, payslip templates, effective salary configurations, and payroll results.

/// Payroll processing and approval states, including payment completion.
enum PayrollStatus {
  draft
  pending_approval
  approved
  rejected
  paid
}

/// Salary component classification as an addition or a deduction.
enum ComponentType {
  addition
  deduction
}

/// Value interpretation for salary components: currency, number, or percentage.
enum ComponentValueType {
  currency
  number
  percentage
}

/// Reusable salary calculation component with a formula and value interpretation. Referenced by template memberships and calculated payslip lines.
model SalaryComponent {
  id          String             @id @default(cuid())
  code        String             @unique @default(cuid())
  name        String             @unique
  type        ComponentType
  valueType   ComponentValueType @default(currency)
  formula     String
  description String?
  isActive    Boolean            @default(true)
  createdById String
  createdBy   Employee           @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslipTemplateComponents PayslipTemplateComponent[]
  payslipDetails            PayslipDetail[]

  @@index([type, isActive])
  @@index([createdById])
}

/// Named decimal input available to salary calculations. Codes uniquely identify variables independently of their display names.
model SalaryVariable {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  value       Decimal @default(0) @db.Decimal(15, 2)
  description String?
  isActive    Boolean @default(true)

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

/// Reusable collection of salary components referenced by employee salary configurations.
model PayslipTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components    PayslipTemplateComponent[]
  salaryConfigs EmployeeSalaryConfig[]

  @@index([isActive])
  @@index([createdById])
}

/// Join record adding a salary component to a payslip template. An optional formula overrides the component formula for this membership.
model PayslipTemplateComponent {
  templateId      String
  template        PayslipTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  componentId     String
  component       SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  overrideFormula String?

  @@id([templateId, componentId])
  @@index([componentId])
}

/// Employee base salary and payslip template for an effective date range. Generated payslips reference the configuration; overlapping date ranges are not prevented here.
model EmployeeSalaryConfig {
  id         String          @id @default(cuid())
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  templateId String
  template   PayslipTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  baseSalary Decimal @db.Decimal(15, 2)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  note          String?

  createdById String
  createdBy   Employee @relation("SalaryConfigCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@index([employeeId, effectiveFrom(sort: Desc)])
  @@index([templateId])
  @@index([effectiveTo])
  @@index([createdById])
}

/// Payroll generation and approval timing configuration with an editor reference. The identifier defaults to GLOBAL; the schema does not enforce a singleton.
model PayrollSettings {
  id             String   @id @default("GLOBAL")
  triggerDay     Int
  triggerHour    Int      @default(0)
  triggerMinute  Int      @default(0)
  approvalDay    Int      @default(10)
  approvalHour   Int      @default(0)
  approvalMinute Int      @default(0)
  updatedById    String
  updatedBy      Employee @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedById])
}

/// Payroll batch for a named month and year, with approval metadata and a stored total. Contains employee payslips and is unique by year, month, and name.
model Payroll {
  id           String        @id @default(cuid())
  name         String        @default("Bảng lương")
  periodMonth  Int
  periodYear   Int
  status       PayrollStatus @default(draft)
  totalAmount  Decimal       @default(0) @db.Decimal(15, 2)
  approvedById String?
  approvedBy   Employee?     @relation(fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt   DateTime?
  rejectReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payslips Payslip[]

  @@unique([periodYear, periodMonth, name])
  @@index([status, periodYear(sort: Desc), periodMonth(sort: Desc)])
  @@index([approvedById])
}

/// Employee payroll result linked to the salary configuration used for calculation. Stores attendance totals and compensation totals; each payroll has at most one payslip per employee.
model Payslip {
  id         String   @id @default(cuid())
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  salaryConfigId String
  salaryConfig   EmployeeSalaryConfig @relation(fields: [salaryConfigId], references: [id], onDelete: Restrict)

  totalAdditions  Decimal @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal @default(0) @db.Decimal(15, 2)
  netSalary       Decimal @db.Decimal(15, 2)
  workingDays     Int     @default(0)
  absentDays      Int     @default(0)
  overtimeMinutes Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  details PayslipDetail[]

  @@unique([payrollId, employeeId])
  @@index([employeeId, payrollId(sort: Desc)])
  @@index([employeeId, createdAt(sort: Desc)])
  @@index([salaryConfigId])
}

/// Calculated salary component line belonging to a payslip. Stores the line name, classification, and value alongside the source component reference.
model PayslipDetail {
  id          String          @id @default(cuid())
  payslipId   String
  payslip     Payslip         @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentId String
  component   SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  name        String
  type        ComponentType
  value       Decimal         @db.Decimal(15, 2)

  @@index([payslipId])
  @@index([componentId])
}

// Module: Projects, tasks and time tracking
// Project configuration, team membership, hierarchical tasks, and reviewed time entries.

/// Project lifecycle states from planning through completion or cancellation.
enum ProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

/// Working-location categories for project membership.
enum ProjectMemberWorkMode {
  remote
  onsite
}

/// Project policy selecting which members may create tasks. The application layer enforces the policy.
enum TaskCreationPolicy {
  leader_only
  all_members
}

/// Built-in task workflow states, separate from project-specific custom statuses.
enum TaskStatus {
  todo
  in_progress
  in_review
  done
  cancelled
  reopened
}

/// Priority levels for project tasks.
enum TaskPriority {
  low
  medium
  high
  urgent
}

/// Review states for employee time entries on tasks.
enum SpentTimeStatus {
  pending
  approved
  rejected
}

/// Project workspace containing members, tasks, tracker definitions, roles, and custom statuses. Records leadership, creation policy, and delivery dates.
model Project {
  id                 String             @id @default(cuid())
  name               String             @unique
  description        String?
  techStack          String[]
  status             ProjectStatus      @default(planning)
  taskCreationPolicy TaskCreationPolicy @default(leader_only)
  startDate          DateTime?
  expectedEndDate    DateTime?
  actualEndDate      DateTime?
  dealTargetPercent  Float?
  teamLeaderId       String?
  teamLeader         Employee?          @relation("ProjectTeamLeader", fields: [teamLeaderId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          Employee           @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             ProjectMember[]
  tasks               Task[]
  customQueries       CustomQuery[]
  taskStatuses        ProjectTaskStatus[]
  roles               ProjectRole[]
  allowedTaskTrackers String[]
  trackers            ProjectTracker[]

  @@index([status])
  @@index([teamLeaderId, status])
  @@index([createdById])
}

/// Project-specific membership role with allowed task tracker codes. Names and codes are unique within a project.
model ProjectRole {
  id                  String   @id @default(cuid())
  projectId           String
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  code                String
  allowedTaskTrackers String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  members ProjectMember[]

  @@unique([projectId, name])
  @@unique([projectId, code])
  @@map("project_roles")
}

/// Project-specific task tracker definition with an activation flag. Task tracker values are stored as strings rather than foreign keys to this model.
model ProjectTracker {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@unique([projectId, code])
  @@map("project_trackers")
}

/// Project-specific custom workflow status with ordering and completion flags. Referenced optionally by tasks alongside their built-in status.
model ProjectTaskStatus {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  color       String   @default("#A3A3A3")
  order       Int      @default(0)
  isDefault   Boolean  @default(false)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tasks       Task[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// Employee membership in a project with an optional role, hourly rate, and removal timestamp. The project/employee primary key permits one membership record per pair.
model ProjectMember {
  projectId  String
  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  hourlyRate Decimal?              @db.Decimal(12, 2)
  workMode   ProjectMemberWorkMode @default(remote)
  roleId     String?
  role       ProjectRole?          @relation(fields: [roleId], references: [id], onDelete: SetNull)
  joinedAt   DateTime              @default(now())
  removedAt  DateTime?

  @@id([projectId, employeeId])
  @@index([employeeId])
  @@index([roleId])
}

/// Project work item with assignment, planning, progress, and optional custom status. Self-relations represent parent tasks and subtasks; time entries attach to individual tasks.
model Task {
  id              String       @id @default(cuid())
  projectId       String
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  tracker         String       @default("feature")
  priority        TaskPriority @default(medium)
  status          TaskStatus   @default(todo)
  assigneeId      String?
  assignee        Employee?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       Employee     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  startDate       DateTime?    @db.Date
  dueDate         DateTime?
  completedAt     DateTime?
  estimatedTime   Float?
  progress        Int          @default(0)
  resultUrl       String?
  resultNotes     String?
  rejectionReason String?
  parentTaskId    String?
  parentTask      Task?        @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks        Task[]       @relation("TaskSubtasks")

  statusId     String?
  customStatus ProjectTaskStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spentTimes SpentTime[] @relation("TaskSpentTimes")

  @@index([projectId, status])
  @@index([projectId, statusId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([statusId])
  @@index([assigneeId, status])
  @@index([assigneeId, dueDate(sort: Asc)])
  @@index([assigneeId, createdAt(sort: Desc)])
  @@index([dueDate, status])
  @@index([createdById])
  @@index([parentTaskId])
}

/// Employee time entry for a task and date, with review metadata. Stores hours, activity, and work-time classification independently of shift attendance.
model SpentTime {
  id              String          @id @default(cuid())
  taskId          String
  task            Task            @relation("TaskSpentTimes", fields: [taskId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee        @relation("EmployeeSpentTimes", fields: [employeeId], references: [id], onDelete: Restrict)
  date            DateTime        @db.Date
  hours           Float
  comment         String?
  activity        String
  workTimeType    String          @default("working_day")
  status          SpentTimeStatus @default(pending)
  approvedById    String?
  approvedBy      Employee?       @relation("SpentTimeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([taskId, status])
  @@index([employeeId, date(sort: Desc)])
  @@index([employeeId, status, date(sort: Desc)])
  @@index([status, date])
  @@index([approvedById])
}

/// Employee-owned saved query definition with an optional project scope. Stores a query type and serialized query data.
model CustomQuery {
  id         String   @id @default(cuid())
  name       String
  type       String   @default("gantt")
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  queryData  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, type])
  @@index([projectId])
}

// Module: Authentication
// Password reset requests and refresh token lifecycle records.

/// Password reset request states covering review, consumption, and expiration.
enum PasswordResetStatus {
  pending
  approved
  rejected
  used
  expired
}

/// Employee password reset request with a unique token, expiration, and optional approver. Approval and token consumption state are stored separately from refresh tokens.
model PasswordResetRequest {
  id           String              @id @default(cuid())
  employeeId   String
  employee     Employee            @relation("PasswordResetRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  token        String              @unique
  status       PasswordResetStatus @default(pending)
  approvedById String?
  approvedBy   Employee?           @relation("PasswordResetRequestApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  note         String?
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([expiresAt])
  @@index([approvedById])
}

/// Hashed employee refresh token with expiration and optional revocation timestamp. Each stored token hash is unique.
model RefreshToken {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([employeeId])
  @@index([expiresAt])
}

// Module: Authorization and access control
// Application roles, permissions, employee grants, and authorization change history.

/// Application access role with system, administrative, default, and activation flags. Links permissions and employees through explicit join tables and supports soft deletion.
model AppRole {
  id               String  @id @default(cuid())
  name             String
  description      String?
  isSystem         Boolean @default(false)
  isActive         Boolean @default(true)
  isAdministrative Boolean @default(false)
  isDefault        Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  permissions RolePermission[]
  employees   EmployeeRole[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
  @@index([isDefault])
  @@index([isAdministrative, isActive, deletedAt])
  @@map("roles")
}

/// Named capability identified by a unique code and module. Assigned to roles through RolePermission and supports activation and soft deletion.
model Permission {
  id          String  @id @default(cuid())
  name        String
  code        String
  module      String
  description String?
  isActive    Boolean @default(true)
  isSystem    Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  roles RolePermission[]

  @@index([module])
  @@index([code])
  @@index([deletedAt])
  @@map("permissions")
}

/// Join record granting a permission to a role, with assignment metadata. The composite primary key prevents duplicate grants.
model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())
  assignedBy   String?

  role       AppRole    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Join record assigning an application role to an employee. The composite primary key prevents duplicate employee/role assignments.
model EmployeeRole {
  employeeId String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role     AppRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([employeeId, roleId])
  @@index([roleId])
  @@map("employee_roles")
}

/// Coordination record for administrative state changes. The identifier defaults to 1; locking behavior must be implemented by database transactions in the application.
model AdminStateLock {
  id Int @id @default(1)

  @@map("admin_state_lock")
}

/// Authorization change record with actor, target identifiers, and before/after JSON values. Employee references are optional; role and permission target identifiers have no Prisma relations.
model AuthorizationAuditLog {
  id                 String  @id @default(uuid())
  actorId            String?
  targetEmployeeId   String?
  targetRoleId       String?
  targetPermissionId String?

  action   String
  oldValue Json?
  newValue Json?
  metadata Json?

  createdAt DateTime @default(now())

  actor          Employee? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetEmployee Employee? @relation("AuditLogTarget", fields: [targetEmployeeId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([targetEmployeeId])
  @@index([targetRoleId])
  @@index([createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("authorization_audit_logs")
}

// Module: Activity audit
// Authentication, role, and security events with retention timestamps.

/// Audit categories for authentication, role management, and security events.
enum ActivityCategory {
  auth
  role
  security
}

/// Recorded employee authentication, role assignment, and account locking actions.
enum ActivityAction {
  login
  logout
  failed_login
  role_assigned
  role_revoked
  account_locked
  account_unlocked
}

/// Authentication and security activity event with optional employee attribution. Stores an IP address, JSON details, and an expiration timestamp for retention processing.
model ActivityLog {
  id         String           @id @default(cuid())
  employeeId String?
  employee   Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  category   ActivityCategory @default(auth)
  actionType ActivityAction
  ipAddress  String?
  details    Json?            @db.JsonB
  expiresAt  DateTime

  createdAt DateTime @default(now())

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([category, actionType, createdAt])
  @@index([category])
  @@index([expiresAt])
}

// Module: Recruitment
// Hiring requisitions, channel postings, intake, interviews, offers, and candidate screening.

/// Hiring requisition lifecycle states from drafting and approval through closure or fulfillment.
enum RequisitionStatus {
  draft
  pending_approval
  approved
  rejected
  closed
  filled
}

/// Urgency levels for hiring requisitions.
enum RequisitionPriority {
  low
  medium
  high
  urgent
}

/// Publication states for a recruitment job posting.
enum PostingStatus {
  draft
  open
  paused
  closed
  archived
}

/// Supported publication and connector channels for job postings.
enum RecruitmentChannel {
  linkedin
  facebook
  google_form
  company_website
  agency
  referral
  other
}

/// Readiness and error states for a job posting's external connector.
enum ConnectorStatus {
  not_configured
  ready
  error
}

/// Candidate application lifecycle states from intake through hiring or termination of consideration.
enum RecruitmentApplicationStatus {
  new
  reviewing
  shortlisted
  interviewing
  final_review
  offer_sent
  offer_accepted
  offer_declined
  offer_rescinded
  background_check
  pending_onboarding
  hired
  rejected
  candidate_withdrew
}

/// Origin categories recorded on candidates, postings, intake records, and recruitment applications.
enum RecruitmentSource {
  website
  linkedin
  referral
  facebook
  recruitment_agency
  google_form
  company_website
  agency
  other
}

/// Supported interview delivery formats.
enum InterviewFormat {
  in_person
  video_call
  phone
}

/// Scheduling and completion states for an interview round.
enum InterviewRoundStatus {
  scheduled
  completed
  cancelled
  no_show
}

/// Evaluation outcomes recorded independently of interview scheduling status.
enum InterviewResult {
  pass
  fail
  pending
  no_show
}

/// Background check group codes stored on candidate screening records. Group-specific verification requirements are defined outside this schema.
enum BgcGroup {
  a
  b
  c
  d
}

/// Processing and outcome states for a background check.
enum BgcStatus {
  pending
  in_progress
  completed
  passed
  failed
}

/// Candidate offer lifecycle states from drafting through response, withdrawal, or expiration.
enum RecruitmentOfferStatus {
  draft
  sent
  accepted
  declined
  rescinded
  expired
}

/// Processing states for raw recruitment intake records.
enum IntakeStatus {
  received
  processed
  failed
}

/// Supported input formats for configurable candidate form fields.
enum RecruitmentFieldType {
  short_text
  paragraph
}

/// Hiring request with headcount, compensation range, position, and approval metadata. Owns job postings, application records, candidate field definitions, and pipeline configuration.
model JobRequisition {
  id              String              @id @default(cuid())
  code            String              @unique
  title           String
  department      String?
  positionLevel   String?
  employmentType  EmployeeType
  salaryMin       Decimal?            @db.Decimal(15, 2)
  salaryMax       Decimal?            @db.Decimal(15, 2)
  currency        String              @default("VND")
  headcount       Int                 @default(1)
  filledCount     Int                 @default(0)
  priority        RequisitionPriority @default(medium)
  status          RequisitionStatus   @default(draft)
  reason          String?             @db.Text
  targetHireDate  DateTime?           @db.Date
  targetCloseDate DateTime?           @db.Date

  summary          String? @db.Text
  responsibilities String? @db.Text
  requirements     String? @db.Text
  benefits         String? @db.Text

  requestedById   String
  requestedBy     Employee  @relation("RequisitionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approverId      String?
  approver        Employee? @relation("RequisitionDesignatedApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvedById    String?
  approvedBy      Employee? @relation("RequisitionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?
  approvalComment String?

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postings        JobPosting[]
  applications    RecruitmentApplication[]
  candidateFields CandidateFieldDefinition[]
  pipelineStages  RecruitmentPipelineStage[]

  @@index([status])
  @@index([requestedById])
  @@index([approverId])
  @@index([positionId])
  @@index([department])
  @@index([approvedById])
}

/// Channel-specific publication of a hiring requisition. Tracks connector configuration, external identity, lifecycle timestamps, form snapshots, and candidate intake.
model JobPosting {
  id              String                   @id @default(cuid())
  requisitionId   String
  requisition     JobRequisition           @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  channel         RecruitmentChannel
  source          RecruitmentSource
  sourceCode      String                   @unique
  formFields      Json?
  status          PostingStatus            @default(draft)
  postingUrl      String?
  externalId      String?
  connectorStatus ConnectorStatus          @default(not_configured)
  oauthAccountId  String?
  oauthAccount    RecruitmentOAuthAccount? @relation(fields: [oauthAccountId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  lastSyncedAt    DateTime?
  closedAt        DateTime?
  archivedAt      DateTime?
  archivedById    String?
  archivedBy      Employee?                @relation("RecruitmentPostingArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  applications       RecruitmentApplication[]
  intakeRecords      RecruitmentIntakeRecord[]
  connectorResponses RecruitmentConnectorResponse[]
  activities         RecruitmentPostingActivity[]
  pipelineStages     RecruitmentPipelineStage[]
  fieldSnapshots     PostingFieldSnapshot[]

  @@unique([id, requisitionId])
  @@index([requisitionId])
  @@index([channel])
  @@index([source])
  @@index([status])
  @@index([oauthAccountId])
  @@index([archivedById])
}

/// Configurable candidate form field belonging to a requisition. Field keys and positions are each unique within the requisition.
model CandidateFieldDefinition {
  id            String               @id @default(cuid())
  requisitionId String
  requisition   JobRequisition       @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  key           String
  label         String
  type          RecruitmentFieldType
  required      Boolean              @default(false)
  position      Int
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([requisitionId, key])
  @@unique([requisitionId, position])
  @@index([requisitionId])
}

/// Posting-specific copy of candidate form field configuration. Preserves labels, required flags, ordering, and optional external question identifiers.
model PostingFieldSnapshot {
  id                 String               @id @default(cuid())
  postingId          String
  posting            JobPosting           @relation(fields: [postingId], references: [id], onDelete: Cascade)
  fieldKey           String
  label              String
  type               RecruitmentFieldType
  required           Boolean              @default(false)
  position           Int
  externalQuestionId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([postingId, fieldKey])
  @@unique([postingId, position])
  @@index([postingId])
  @@index([externalQuestionId])
}

/// Raw candidate submission received for a posting, with processing state and error details. sourceRef is globally unique; candidateId and applicationId are scalar identifiers without Prisma relations.
model RecruitmentIntakeRecord {
  id              String            @id @default(cuid())
  postingId       String
  posting         JobPosting        @relation(fields: [postingId], references: [id], onDelete: Cascade)
  source          RecruitmentSource
  sourceRef       String            @unique
  rawPayload      Json
  processedStatus IntakeStatus      @default(received)
  errorMessage    String?           @db.Text
  candidateId     String?
  applicationId   String?

  createdAt DateTime @default(now())

  @@index([postingId])
  @@index([processedStatus])
}

/// Employee-owned credentials for a recruitment channel integration. Job postings may reference the account; credential encryption is not specified by the schema.
model RecruitmentOAuthAccount {
  id           String             @id @default(cuid())
  userId       String
  user         Employee           @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      RecruitmentChannel
  name         String             @default("Default")
  clientId     String
  clientSecret String
  refreshToken String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  postings JobPosting[]

  @@index([userId])
  @@index([channel])
}

/// OAuth state nonce with expiration and optional consumption timestamp. The nonce itself is the primary key.
model RecruitmentOAuthStateNonce {
  nonce      String    @id
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

/// Candidate profile and source information shared across recruitment applications. Links flexible metadata, offers, and background checks.
model Candidate {
  id          String    @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  dateOfBirth DateTime? @db.Date
  address     String?
  nationalId  String?

  source       RecruitmentSource
  linkedinUrl  String?
  portfolioUrl String?
  cvUrl        String?
  avatarUrl    String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications     RecruitmentApplication[]
  metadata         CandidateMeta[]
  offers           RecruitmentOffer[]
  backgroundChecks BackgroundCheck[]

  @@index([email])
  @@index([source])
}

/// JSON metadata entry for a candidate. Each candidate can have only one value for a given metadata key.
model CandidateMeta {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  metaKey     String
  value       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, metaKey])
  @@index([metaKey])
}

/// Candidate application linking a requisition, posting, and pipeline stage. Stores workflow state, recruiter assignment, and interview/offer history; cross-reference consistency requires application validation.
model RecruitmentApplication {
  id              String                   @id @default(cuid())
  requisitionId   String
  requisition     JobRequisition           @relation(fields: [requisitionId], references: [id], onDelete: Restrict)
  candidateId     String
  candidate       Candidate                @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  postingId       String
  posting         JobPosting               @relation(fields: [postingId], references: [id], onDelete: Restrict)
  pipelineStageId String
  pipelineStage   RecruitmentPipelineStage @relation(fields: [pipelineStageId], references: [id], onDelete: Restrict)

  status         RecruitmentApplicationStatus @default(new)
  rejectReason   String?                      @db.Text
  withdrawReason String?

  appliedAt DateTime          @default(now())
  source    RecruitmentSource
  sourceRef String?

  assignedToId String?
  assignedTo   Employee? @relation("RecruitmentAppRecruiter", fields: [assignedToId], references: [id], onDelete: SetNull)

  hiredAt   DateTime?
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  interviewRounds    InterviewRound[]
  offers             RecruitmentOffer[]
  notes              ApplicationNote[]
  connectorResponses RecruitmentConnectorResponse[]
  postingActivities  RecruitmentPostingActivity[]

  @@index([requisitionId, candidateId])
  @@index([requisitionId, createdAt(sort: Desc)])
  @@index([candidateId])
  @@index([postingId])
  @@index([assignedToId])
  @@index([status, createdAt(sort: Desc)])
  @@index([pipelineStageId])
  @@index([postingId, pipelineStageId])
  @@index([postingId, createdAt])
  @@index([id, version])
}

/// Ordered recruitment workflow stage with optional posting and requisition scope. Referenced by applications; the schema does not require exactly one scope.
model RecruitmentPipelineStage {
  id            String          @id @default(cuid())
  postingId     String?
  posting       JobPosting?     @relation(fields: [postingId], references: [id], onDelete: Cascade)
  requisitionId String?
  requisition   JobRequisition? @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  name          String
  color         String
  position      Int
  isDefault     Boolean         @default(false)
  isCompleted   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  applications RecruitmentApplication[]

  @@unique([postingId, position])
  @@unique([id, postingId])
  @@index([postingId])
  @@index([requisitionId, position])
}

/// Posting activity event with optional candidate application and employee actor. Stores an event type and extensible JSON metadata.
model RecruitmentPostingActivity {
  id            String                  @id @default(cuid())
  postingId     String
  posting       JobPosting              @relation(fields: [postingId], references: [id], onDelete: Cascade)
  applicationId String?
  application   RecruitmentApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  actorId       String?
  actor         Employee?               @relation("RecruitmentPostingActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  type          String
  metadata      Json?
  createdAt     DateTime                @default(now())

  @@index([postingId, createdAt])
  @@index([applicationId])
  @@index([actorId])
  @@index([type])
}

/// External response processed for a posting, with optional linked application and error details. Posting/external-response pairs are unique; an application can link to at most one response.
model RecruitmentConnectorResponse {
  id                 String                  @id @default(cuid())
  postingId          String
  posting            JobPosting              @relation(fields: [postingId], references: [id], onDelete: Cascade)
  externalResponseId String
  applicationId      String?                 @unique
  application        RecruitmentApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  errorCode          String?
  errorMessage       String?                 @db.Text
  responseData       Json?
  processedAt        DateTime                @default(now())

  @@unique([postingId, externalResponseId])
}

/// Recruiter-authored note attached to a candidate recruitment application. This model belongs to recruitment, not employee request applications.
model ApplicationNote {
  id            String                 @id @default(cuid())
  applicationId String
  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  note          String                 @db.Text
  addedById     String
  addedBy       Employee               @relation("RecruitmentNoteCreator", fields: [addedById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId, createdAt(sort: Desc)])
  @@index([addedById])
}

/// Scheduled interview for a recruitment application, with format, result, and feedback. Interviewer identifiers are stored as an array; evaluator scorecards are related records.
model InterviewRound {
  id            String                 @id @default(cuid())
  applicationId String
  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  roundNumber Int
  title       String
  format      InterviewFormat @default(video_call)

  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  location        String?
  meetingLink     String?

  interviewerIds String[]
  status         InterviewRoundStatus @default(scheduled)
  result         InterviewResult      @default(pending)
  feedback       String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scorecards Scorecard[]

  @@index([applicationId, roundNumber(sort: Asc)])
  @@index([scheduledAt])
  @@index([status])
}

/// Evaluator assessment of an interview round with ratings, structured scores, and answers. Each evaluator can submit one scorecard per interview.
model Scorecard {
  id          String         @id @default(cuid())
  interviewId String
  interview   InterviewRound @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  evaluatorId String
  evaluator   Employee @relation("ScorecardEvaluator", fields: [evaluatorId], references: [id], onDelete: Restrict)

  overallRating  Int
  strengths      String? @db.Text
  weaknesses     String? @db.Text
  recommendation String?

  scores  Json?
  answers Json?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([interviewId, evaluatorId])
  @@index([interviewId])
  @@index([evaluatorId])
}

/// Candidate employment offer linked to a recruitment application and its creator. Stores current terms, version records, and an optional background check.
model RecruitmentOffer {
  id            String                 @id @default(cuid())
  applicationId String
  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId   String
  candidate     Candidate              @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  currentVersion Int                    @default(1)
  status         RecruitmentOfferStatus @default(draft)

  offeredSalary Decimal   @db.Decimal(15, 2)
  currency      String    @default("VND")
  startDate     DateTime  @db.Date
  endDate       DateTime? @db.Date
  trialEndDate  DateTime? @db.Date

  jobTitle       String?
  department     String?
  employmentType EmployeeType

  benefits Json?
  notes    String? @db.Text

  createdById  String
  createdBy    Employee  @relation("OfferCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sentAt       DateTime?
  respondedAt  DateTime?
  responseNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions        OfferVersion[]
  backgroundCheck BackgroundCheck?

  @@index([applicationId, createdAt(sort: Desc)])
  @@index([candidateId])
  @@index([status])
  @@index([createdById])
}

/// Versioned compensation and date terms for a recruitment offer. Version numbers are unique within an offer; createdById has no Prisma relation.
model OfferVersion {
  id      String           @id @default(cuid())
  offerId String
  offer   RecruitmentOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  version   Int
  salary    Decimal   @db.Decimal(15, 2)
  currency  String    @default("VND")
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  changeReason String?
  notes        String? @db.Text

  createdById String
  createdAt   DateTime @default(now())

  @@unique([offerId, version])
  @@index([offerId])
}

/// Candidate screening record for an offer, with verification flags and outcome timestamps. Each offer has at most one check, optionally attributed to an employee reviewer.
model BackgroundCheck {
  id          String           @id @default(cuid())
  offerId     String           @unique
  offer       RecruitmentOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  group  BgcGroup
  status BgcStatus @default(pending)

  idVerified      Boolean?
  addressVerified Boolean?

  criminalRecordCheck Boolean?
  legalStatusCheck    Boolean?

  certificationVerified     Boolean?
  employmentHistoryVerified Boolean?

  financialCheckCompleted Boolean?
  creditScoreCheck        Boolean?

  completedAt DateTime?
  passedAt    DateTime?
  failedAt    DateTime?
  failReason  String?   @db.Text

  checkedById String?
  checkedBy   Employee? @relation("BgcChecker", fields: [checkedById], references: [id], onDelete: SetNull)

  documents Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([status])
  @@index([checkedById])
}

// Module: Notifications
// Shared notification content and independent read/deletion state for each recipient.

/// Notification content addressed to an employee or the whole system. A null employeeId denotes a system-wide notification; recipient state is stored separately.
model Notification {
  id         String    @id @default(uuid())
  employeeId String?
  employee   Employee? @relation("NotificationTarget", fields: [employeeId], references: [id], onDelete: Cascade)

  title     String
  message   String
  type      String
  priority  String
  link      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states NotificationRecipientState[]

  @@index([employeeId, createdAt])
  @@index([employeeId, type, createdAt])
}

/// Per-employee read and deletion state for a notification. The composite primary key isolates each recipient's state from other recipients.
model NotificationRecipientState {
  notificationId String
  employeeId     String
  read           Boolean  @default(false)
  deleted        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([notificationId, employeeId])
  @@index([employeeId, deleted, read])
}
